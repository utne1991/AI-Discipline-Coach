# ==============================================================================
# AI Discipline Coach — Environment Configuration Template
# Never commit real secrets, API keys, service accounts, or production credentials.
# ==============================================================================

# Environment isolation: development | staging | production
APP_ENV="development"

# Primary data provider (strictly ONE primary provider per environment):
# - firestore: DEV / MVP Firestore primary store
# - postgres: Local PostgreSQL or Cloud SQL (Staging / Production)
DATA_PROVIDER="firestore"

# AI provider selection:
# - gemini: Real Gemini API (required in production; never falls back to mock)
# - mock: Deterministic local/DEV simulator (strictly forbidden when APP_ENV=production)
AI_PROVIDER="gemini"

# Server runtime
PORT="3000"
APP_URL="http://localhost:3000"

# Gemini AI API (server-side only; never expose with VITE_ prefix)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# PostgreSQL / Cloud SQL connection (used when DATA_PROVIDER=postgres)
# In local PostgreSQL use TCP host (e.g., localhost); in Cloud Run use Unix socket path.
SQL_HOST="localhost"
SQL_PORT="5432"
SQL_DB_NAME="ai_discipline_coach_dev"
SQL_USER="postgres"
SQL_PASSWORD="CHANGE_ME_LOCAL_ONLY"
SQL_ADMIN_USER="postgres"
SQL_ADMIN_PASSWORD="CHANGE_ME_LOCAL_ONLY"

# Optional: Firebase Emulator hosts for local rules/auth testing
# FIRESTORE_EMULATOR_HOST="127.0.0.1:8080"
# FIREBASE_AUTH_EMULATOR_HOST="127.0.0.1:9099"
